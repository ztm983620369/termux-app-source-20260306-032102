<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.Termux.TmuxControlButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_margin">1dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:scrollHorizontally">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/tmux_control_text</item>
        <item name="android:textSize">8sp</item>
        <item name="backgroundTint">@color/tmux_control_background</item>
        <item name="cornerRadius">3dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">1dp</item>
        <item name="iconSize">14dp</item>
        <item name="iconTint">@color/tmux_control_text</item>
        <item name="rippleColor">#5265D69A</item>
        <item name="strokeColor">@color/tmux_control_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Termux.TmuxControlButton.Primary" parent="Widget.Termux.TmuxControlButton">
        <item name="android:textColor">@color/tmux_control_primary_text</item>
        <item name="backgroundTint">@color/tmux_control_primary_background</item>
        <item name="iconTint">@color/tmux_control_primary_text</item>
        <item name="strokeColor">@color/tmux_control_primary_stroke</item>
    </style>

    <style name="Widget.Termux.TmuxControlButton.Danger" parent="Widget.Termux.TmuxControlButton">
        <item name="android:textColor">@color/tmux_control_danger_text</item>
        <item name="backgroundTint">@color/tmux_control_danger_background</item>
        <item name="iconTint">@color/tmux_control_danger_text</item>
        <item name="rippleColor">#52FF6B74</item>
        <item name="strokeColor">@color/tmux_control_danger_stroke</item>
    </style>

    <style name="Widget.Termux.TmuxControlButton.Warning" parent="Widget.Termux.TmuxControlButton">
        <item name="android:textColor">@color/tmux_control_warning_text</item>
        <item name="backgroundTint">@color/tmux_control_warning_background</item>
        <item name="iconTint">@color/tmux_control_warning_text</item>
        <item name="rippleColor">#52F5C56B</item>
        <item name="strokeColor">@color/tmux_control_warning_stroke</item>
    </style>

</resources>
