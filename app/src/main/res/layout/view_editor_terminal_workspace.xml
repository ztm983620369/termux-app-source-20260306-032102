<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/editor_terminal_workspace_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/black">

    <com.termux.app.topbar.TerminalTopBarView
        android:id="@+id/editor_terminal_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.termux.terminalsessionsurface.TerminalSessionSurfaceView
        android:id="@+id/editor_terminal_session_surface"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
