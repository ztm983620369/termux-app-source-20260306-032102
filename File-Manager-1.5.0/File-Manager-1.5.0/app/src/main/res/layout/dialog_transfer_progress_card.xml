<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/transfer_progress_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:id="@+id/transfer_progress_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/transfer_progress_icon_holder"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="16dp"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/transfer_progress_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/transfer_progress_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="下载中" />

                <TextView
                    android:id="@+id/transfer_progress_file_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:textSize="13sp"
                    tools:text="example.apk" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/transfer_progress_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:textAllCaps="true"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="APK" />

                <TextView
                    android:id="@+id/transfer_progress_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:includeFontPadding="false"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="42%" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/transfer_progress_indeterminate_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:indeterminate="true"
            app:trackThickness="6dp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/transfer_progress_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:indeterminate="false"
            android:max="100"
            android:visibility="gone"
            app:trackThickness="6dp"
            tools:progress="42"
            tools:visibility="visible" />

        <View
            android:id="@+id/transfer_progress_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/transfer_progress_files_label"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="@string/transfer_files_count"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/transfer_progress_files_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="14sp"
                    tools:text="3 / 8" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/transfer_progress_size_label"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="@string/transfer_size"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/transfer_progress_size_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="14sp"
                    tools:text="12 MB / 40 MB" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/transfer_progress_speed_label"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="@string/transfer_speed"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/transfer_progress_speed_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="14sp"
                    tools:text="1.2 MB/s" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/transfer_progress_failed_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/transfer_progress_failed_label"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="@string/transfer_failed"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/transfer_progress_failed_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="14sp"
                    tools:text="1" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/transfer_progress_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingExtra="2dp"
        android:textSize="12sp"
        tools:text="正在下载..." />

    <TextView
        android:id="@+id/transfer_progress_cancel"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="end"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:minWidth="72dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="@string/transfer_cancel"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
